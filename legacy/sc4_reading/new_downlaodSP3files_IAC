from ftplib import FTP_TLS
from datetime import datetime, timedelta
import os
import gzip
import shutil

# --------------------------------------------------
# Convert date to GPS week
# --------------------------------------------------
def date_to_gps_week(date_obj):
    gps_epoch = datetime(1980, 1, 6)
    delta_days = (date_obj - gps_epoch).days
    gps_week = delta_days // 7
    gps_dow = delta_days % 7
    return gps_week, gps_dow

# --------------------------------------------------
# User Inputs
# --------------------------------------------------
start_date_str = input("Enter start date (YYYY-MM-DD): ")
end_date_str = input("Enter end date (YYYY-MM-DD): ")

try:
    start_date = datetime.strptime(start_date_str, "%Y-%m-%d")
    end_date = datetime.strptime(end_date_str, "%Y-%m-%d")
except ValueError:
    print("Invalid date format. Use YYYY-MM-DD")
    exit()

if end_date < start_date:
    print("End date must be after start date.")
    exit()

# --------------------------------------------------
# FTP Login
# --------------------------------------------------
email = "your_email@example.com"

ftps = FTP_TLS("gdc.cddis.eosdis.nasa.gov")
ftps.login(user="anonymous", passwd=email)
ftps.prot_p()

# --------------------------------------------------
# Output Directory
# --------------------------------------------------
output_dir = "\home\dal674840\scratch\SP3FILES"
os.makedirs(output_dir, exist_ok=True)

# --------------------------------------------------
# Download Loop
# --------------------------------------------------
current_date = start_date

while current_date <= end_date:

    year = current_date.year
    doy = current_date.timetuple().tm_yday

    gps_week, gps_dow = date_to_gps_week(current_date)

    server_file_name = (
        f"gnss/products/{gps_week:04d}/"
        f"IAC0MGXFIN_{year:04d}{doy:03d}0000_01D_05M_ORB.SP3.gz"
    )

    local_file_name = os.path.join(
        output_dir,
        f"IAC0MGXFIN_{year:04d}{doy:03d}0000_01D_05M_ORB.SP3.gz"
    )

    print(f"\n{current_date.strftime('%Y-%m-%d')}")
    print(f"GPS Week: {gps_week}")
    print(f"Downloading: {server_file_name}")

    if os.path.exists(local_file_name):
        print("File already exists. Skipping.")
        current_date += timedelta(days=1)
        continue

    try:
        with open(local_file_name, "wb") as f:
           ftps.retrbinary(f"RETR {server_file_name}", f.write)

        print("✓ Downloaded .gz")

# Create .SP3 filename
        sp3_file = local_file_name[:-3]  # removes ".gz"

# Extract gzip -> SP3
        with gzip.open(local_file_name, "rb") as f_in:
            with open(sp3_file, "wb") as f_out:
                shutil.copyfileobj(f_in, f_out)

        print(f"✓ Extracted: {os.path.basename(sp3_file)}")

# Optional: delete .gz after extraction
        os.remove(local_file_name)

        print("✓ Removed .gz file")

    except Exception as e:
        print(f"✗ Failed: {e}")

    current_date += timedelta(days=1)

# --------------------------------------------------
# Close FTP Connection
# --------------------------------------------------
ftps.quit()

print("\nAll downloads completed.")