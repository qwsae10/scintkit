from pathlib import Path

def cleanup_txt_files(filepath, verbose=True):
    filepath=Path(filepath)

    for file_path in filepath.glob("*.txt"):
        if file_path.is_file():
            file_path.unlink()
        if verbose:
            print(f"Deleted: {file_path.name}")

